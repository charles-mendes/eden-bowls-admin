:80 {
  encode zstd gzip

  root * /srv

  @assets path /assets/*
  header @assets Cache-Control "public, max-age=604800, immutable"

  @public_media path /favicon.svg /icons.svg
  header @public_media Cache-Control "public, max-age=604800"

  @index path /index.html
  header @index Cache-Control "no-store"

  try_files {path} /index.html
  file_server
}
