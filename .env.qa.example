# Copy this file to .env on the QA VPS (do not reuse a local .env).
#   cp .env.qa.example .env
#   docker compose --env-file .env -f docker-compose.admin.yml up -d --build
#
# VITE_* is baked into the image at build time. Change any value → rebuild with --build.

# Same DSN as local. Environment keeps QA issues out of production alerts.
VITE_SENTRY_DSN=https://dd8929e04ab945746c61e00a982e5e60@o4511821123026944.ingest.us.sentry.io/4512183774150656
VITE_SENTRY_ENVIRONMENT=qa

# API lives on its own host. Include /api/v1 here (admin client appends /auth, /admin/...).
VITE_ADMIN_API_BASE_URL=https://qa-api.edenbowls.com/api/v1

# Panel is exposed at https://qa-admin.edenbowls.com (root of the host).
VITE_APP_BASE_PATH=/
